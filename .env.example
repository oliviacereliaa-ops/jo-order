# Copy to .env and fill in. .env is git-ignored: never commit it.
# After editing, run: python scripts/configure.py  (then commit the HTML).

# Password for the lock screen. Also used as the sheet PIN for the tab.
GATE_PASSWORD=

# Apps Script web app URL (Deploy > Manage deployments). Built into the pages.
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# Reference only: the PIN the Apps Script checks. Change it there, not here.
APP_PIN=
